# Copy to .env and replace every placeholder before starting Compose.
POSTGRES_USER=domainmonitor
POSTGRES_PASSWORD=replace-with-a-long-development-password
POSTGRES_DB=domainmonitor
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=8081

DEFAULT_LOCALE=th
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2

# Used only by: docker compose --profile tools run --rm seed-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.internal
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_LOCALE=th

# Phase 2 protocol checker policy. LOCAL_DNS_ADDR is optional; containers use /etc/resolv.conf by default.
LOCAL_DNS_ADDR=
CLOUDFLARE_DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
DOH_MAX_RESPONSE_BYTES=65536
MONITOR_DNS_TIMEOUT=3s
MONITOR_CONNECT_TIMEOUT=5s
MONITOR_TLS_TIMEOUT=7s
MONITOR_RESPONSE_HEADER_TIMEOUT=10s
MONITOR_HTTP_CHAIN_TIMEOUT=25s
MONITOR_MAX_REDIRECTS=10
MONITOR_MAX_BODY_BYTES=2097152
MONITOR_EXCERPT_BYTES=32768
MONITOR_HEADER_BYTES=16384
MONITOR_MIN_BODY_BYTES=64
MONITOR_MAX_ATTEMPTS=3
MONITOR_RETRY_BASE_DELAY=100ms
MONITOR_RETRY_MAX_DELAY=2s
MONITOR_TLS_EXPIRING_SOON=720h
MONITOR_USER_AGENT=DomainMonitor/phase5
MONITOR_POLICY_VERSION=monitor-2026-08-v2
MONITOR_RUN_TIMEOUT=60s
MONITOR_WORKERS=10
MONITOR_QUEUE_GROUP=domain-monitor-workers
MONITOR_QUEUE_LEASE=90s
MONITOR_QUEUE_BLOCK=2s
SCHEDULER_INTERVAL=5s
SCHEDULER_BATCH_SIZE=100
INCIDENT_OPEN_FAILURES=3
INCIDENT_CLOSE_SUCCESSES=2

# Phase 4 remote-probe control plane and ISP evidence policy.
PROBE_REQUIRED_REGION=SG
PROBE_TOKEN_TTL=5m
PROBE_CHALLENGE_TTL=1m
PROBE_JOB_TTL=2m
PROBE_JOB_LEASE=90s
PROBE_STALE_AFTER=90s
PROBE_MAX_CLOCK_SKEW=2m
PROBE_EVIDENCE_FRESHNESS=24h
PROBE_DISPATCH_BATCH=100
PROBE_MAX_PAYLOAD_BYTES=1048576

# Phase 5 RDAP registration intelligence. Bootstrap data comes from IANA.
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_MAX_RESPONSE_BYTES=1048576
RDAP_REQUEST_TIMEOUT=15s
RDAP_BOOTSTRAP_TTL=24h
RDAP_BOOTSTRAP_MAX_STALE=168h
RDAP_DOMAIN_CACHE_TTL=6h
RDAP_MIN_REQUEST_INTERVAL=200ms

# Phase 5 finance reporting. Original amounts/currencies are never overwritten.
FINANCE_FX_MAX_AGE=48h

# Phase 5 Google Sheets read-only integration. Prefer a mounted service-account
# JSON file for scheduled sync. API key is suitable only for public sheets;
# GOOGLE_SHEETS_ACCESS_TOKEN is intended for short-lived development use.
GOOGLE_SHEETS_API_BASE=https://sheets.googleapis.com
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_FILE=
GOOGLE_SHEETS_MAX_RESPONSE_BYTES=4194304
GOOGLE_SHEETS_TIMEOUT=20s

# Optional interactive Google Drive OAuth. Generate the encryption key with a
# cryptographically secure 32-byte random value and store it as standard base64.
# The default drive.file scope limits visibility to files explicitly shared with
# or opened by this app; it avoids requesting all-Drive restricted access.
GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8081/api/v1/google-drive/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets.readonly

# Bounded .xlsx import policy.
EXCEL_IMPORT_MAX_BYTES=10485760
EXCEL_IMPORT_MAX_UNCOMPRESSED_BYTES=67108864
EXCEL_IMPORT_MAX_ROWS=20000
EXCEL_IMPORT_MAX_COLUMNS=100
